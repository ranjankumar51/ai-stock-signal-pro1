# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=AI Stock Signal Pro
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # set true in production

# --- PostgreSQL ---
POSTGRES_HOST=localhost          # docker-compose overrides this to "db"
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_stock_signal
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis ---
REDIS_HOST=localhost             # docker-compose overrides this to "redis"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
